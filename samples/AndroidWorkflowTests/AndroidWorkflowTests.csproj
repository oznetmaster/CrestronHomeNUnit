<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NUnitVersion Condition="'$(NUnitVersion)' == ''">4.6.1</NUnitVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="$(NUnitVersion)" PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" PrivateAssets="all" />
    <PackageReference Include="CrestronHomeNUnit.TestAdapter" Version="1.7.1" PrivateAssets="all" Condition="'$(UseSourceAndroid)' != 'true'" />
    <ProjectReference Include="../../CrestronHomeNUnit.Android/CrestronHomeNUnit.Android.csproj" Condition="'$(UseSourceAndroid)' == 'true'" />
  </ItemGroup>
</Project>
