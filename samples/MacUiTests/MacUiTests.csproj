<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><IsTestProject>true</IsTestProject><ImplicitUsings>enable</ImplicitUsings>
    <MacAdapterVersion Condition="'$(MacAdapterVersion)' == ''">2.4.0-mac-preview.2</MacAdapterVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="CrestronHomeNUnit.TestAdapter" Version="$(MacAdapterVersion)" PrivateAssets="all" Condition="'$(UseSourceMac)' != 'true'" />
    <ProjectReference Include="../../CrestronHomeNUnit.Mac/CrestronHomeNUnit.Mac.csproj" Condition="'$(UseSourceMac)' == 'true'" />
  </ItemGroup>
</Project>
