<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="nunit-snapshot" value="https://www.myget.org/F/nunit/api/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nunit-snapshot"><package pattern="NUnit" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
