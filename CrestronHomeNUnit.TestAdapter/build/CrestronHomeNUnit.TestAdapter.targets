<Project>
  <PropertyGroup>
    <CrestronWorkflowManifest Condition="'$(CrestronWorkflowManifest)' == ''">$(MSBuildProjectDirectory)/Workflows.xml</CrestronWorkflowManifest>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(CrestronWorkflowManifest)')">
    <None Remove="$(CrestronWorkflowManifest)" />
    <None Include="$(CrestronWorkflowManifest)" TargetPath="$(TargetFileName).workflow-tests.xml" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
